NODE_ENV=development
PORT=3000

# postgres | mysql | mariadb  (sqljs = in-memory, used by e2e tests)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_core

# Keep false outside throwaway local databases - use migrations instead.
DB_SYNCHRONIZE=false
DB_LOGGING=false
# Apply pending migrations on app startup.
DB_MIGRATIONS_RUN=false

# Secret the API verifies access tokens with (HS256, 32+ chars). Tokens need `sub`
# and `permissions` claims. `npm run token -- brand.read brand.create` mints a dev token.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Optional: reject tokens not issued by / for these.
JWT_ISSUER=
JWT_AUDIENCE=

# Comma-separated allowed origins; leave empty to disable CORS.
CORS_ORIGINS=http://localhost:5173
# Swagger UI at /docs (defaults to on outside production).
SWAGGER_ENABLED=true
# Rate limit: THROTTLE_LIMIT requests per THROTTLE_TTL milliseconds, per client.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
