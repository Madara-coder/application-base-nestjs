NODE_ENV=development
PORT=3000

# postgres | mysql | mariadb  (sqljs = in-memory, used by e2e tests)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_core

# Keep false outside throwaway local databases - use migrations instead.
DB_SYNCHRONIZE=false
DB_LOGGING=false
# Apply pending migrations on app startup.
DB_MIGRATIONS_RUN=false
